# Copy to .env and edit. docker compose reads it automatically.

# Where mlx-dsppark listens, as seen from inside the container.
UPSTREAM_URL=http://host.docker.internal:8000

# Queue and timeouts
# waiting requests (the running one is not counted)
MAX_QUEUE_SIZE=8
# max time a request may wait before it starts
QUEUE_TIMEOUT_SECONDS=600
# max time for one upstream inference (also the read timeout)
UPSTREAM_TIMEOUT_SECONDS=1200
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
# bytes, not tokens
MAX_REQUEST_BYTES=1048576
# Retry-After sent with 503s
RETRY_AFTER_SECONDS=30

# What happens to a RUNNING job when its caller disconnects or it is cancelled:
#   drain = caller is released at once, gateway reads upstream to the end (safe, wastes GPU time)
#   abort = close the upstream connection, then RECOVERY_COOLDOWN_SECONDS + probe before the next job
STOP_POLICY=drain
RECOVERY_COOLDOWN_SECONDS=10
RECOVERY_ATTEMPTS=3
# false: stay "uncertain" until POST /admin/recover
AUTO_RECOVER=true
SHUTDOWN_GRACE_SECONDS=15

# Priority: callers default to routine. Only TRUSTED_API_KEYS / ADMIN_API_KEY may escalate.
# waiting this long promotes a job one level (0 = never)
PRIORITY_AGING_SECONDS=300
# queue places routine jobs may not use
RESERVED_PRIORITY_SLOTS=2

# Auth (all optional). Use long random values, e.g. `openssl rand -hex 32`.
# if set, every caller must send it as a Bearer token
GATEWAY_API_KEY=
# comma separated; may set X-Priority and escalate jobs
TRUSTED_API_KEYS=
# enables /admin/*
ADMIN_API_KEY=
# sent to mlx-dsppark, if it requires one
UPSTREAM_API_KEY=

# Docker host interface to publish 8001 on (e.g. your Mac's LAN IP, or 127.0.0.1)
GATEWAY_BIND=0.0.0.0
LOG_LEVEL=INFO
